<Window x:Class="TodayLOL.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑截图" Height="700" Width="960"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged"
        Closed="Window_Closed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 工具 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <RadioButton x:Name="ToolPen" Content="画笔" GroupName="Tool" IsChecked="True"
                                 Checked="Tool_Checked" Tag="Pen" Margin="0,0,2,0" Style="{StaticResource ToolButton}"/>
                    <RadioButton x:Name="ToolArrow" Content="箭头" GroupName="Tool" Checked="Tool_Checked" Tag="Arrow"
                                 Margin="0,0,2,0" Style="{StaticResource ToolButton}">
                        <RadioButton.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="为最近画笔添加箭头" Click="AddArrowToLastPenLine_Click"/>
                            </ContextMenu>
                        </RadioButton.ContextMenu>
                    </RadioButton>
                    <RadioButton x:Name="ToolRect" Content="矩形" GroupName="Tool" Checked="Tool_Checked" Tag="Rectangle"
                                 Margin="0,0,2,0" Style="{StaticResource ToolButton}"/>
                    <RadioButton x:Name="ToolText" Content="文字" GroupName="Tool" Checked="Tool_Checked" Tag="Text"
                                 Margin="0,0,2,0" Style="{StaticResource ToolButton}"/>
                    <RadioButton x:Name="ToolMove" Content="移动" GroupName="Tool" Checked="Tool_Checked" Tag="Move"
                                 Margin="0,0,2,0" Style="{StaticResource ToolButton}"/>
                    <RadioButton x:Name="ToolCrop" Content="裁剪" GroupName="Tool" Checked="Tool_Checked" Tag="Crop"
                                 Margin="0,0,2,0" Style="{StaticResource ToolButton}"/>
                    <RadioButton x:Name="ToolStitch" Content="拼接" GroupName="Tool" Checked="Tool_Checked" Tag="Stitch"
                                 Margin="0,0,2,0" Style="{StaticResource ToolButton}"/>
                </StackPanel>

                <!-- 颜色和粗细 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                    <Border Width="1" Background="{StaticResource BorderLightBrush}" Margin="0,4"/>
                    <TextBlock Text="颜色" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" x:Name="ColorPanel">
                        <Border Width="22" Height="22" Margin="2" Background="#E53935"
                                MouseDown="Color_Click" Tag="#E53935" Cursor="Hand" BorderBrush="#333" BorderThickness="2"/>
                        <Border Width="22" Height="22" Margin="2" Background="#1E88E5"
                                MouseDown="Color_Click" Tag="#1E88E5" Cursor="Hand" BorderBrush="Transparent" BorderThickness="2"/>
                        <Border Width="22" Height="22" Margin="2" Background="#43A047"
                                MouseDown="Color_Click" Tag="#43A047" Cursor="Hand" BorderBrush="Transparent" BorderThickness="2"/>
                        <Border Width="22" Height="22" Margin="2" Background="#FB8C00"
                                MouseDown="Color_Click" Tag="#FB8C00" Cursor="Hand" BorderBrush="Transparent" BorderThickness="2"/>
                        <Border Width="22" Height="22" Margin="2" Background="#FFFFFF"
                                MouseDown="Color_Click" Tag="#FFFFFF" Cursor="Hand" BorderBrush="Transparent" BorderThickness="2"/>
                        <Border Width="22" Height="22" Margin="2" Background="#000000"
                                MouseDown="Color_Click" Tag="#000000" Cursor="Hand" BorderBrush="Transparent" BorderThickness="2"/>
                    </StackPanel>

                    <Border Width="1" Background="{StaticResource BorderLightBrush}" Margin="8,4"/>
                    <TextBlock Text="粗细" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="StrokeSizeCombo" Width="52" SelectedIndex="1" VerticalAlignment="Center">
                        <ComboBoxItem Content="细" Tag="2"/>
                        <ComboBoxItem Content="中" Tag="4"/>
                        <ComboBoxItem Content="粗" Tag="8"/>
                    </ComboBox>
                </StackPanel>

                <!-- 缩放控制 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button x:Name="BtnZoomOut" Content="-" Click="ZoomOut_Click" Style="{StaticResource ToolbarButton}" Width="28" Margin="0,0,2,0" FontWeight="Bold"/>
                    <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Width="40" TextAlignment="Center"/>
                    <Button x:Name="BtnZoomIn" Content="+" Click="ZoomIn_Click" Style="{StaticResource ToolbarButton}" Width="28" Margin="0,0,2,0" FontWeight="Bold"/>
                    <Button x:Name="BtnZoomReset" Content="重置" Click="ZoomReset_Click" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0" FontSize="11"/>
                </StackPanel>

                <!-- 右侧：撤销/重做 + 裁剪按钮 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnUndo" Content="撤销" Click="Undo_Click" Style="{StaticResource ToolbarButton}" Margin="0,0,2,0"/>
                    <Button x:Name="BtnRedo" Content="重做" Click="Redo_Click" Style="{StaticResource ToolbarButton}" Margin="0,0,8,0"/>

                    <Button x:Name="ApplyCropBtn" Content="确认裁剪" Click="ApplyCrop_Click"
                            Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Margin="0,0,4,0" Width="32" Height="28"/>
                    <Button x:Name="CancelCropBtn" Content="取消裁剪" Click="CancelCrop_Click"
                            Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Width="32" Height="28"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 画布区域 -->
        <Grid Grid.Row="1" Background="#F0F2F5">
            <ScrollViewer x:Name="CanvasScrollViewer" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" Margin="16"
                          MouseWheel="CanvasScrollViewer_MouseWheel">
                <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                    <Grid x:Name="CanvasContainer">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>
                        <Canvas x:Name="ImageCanvas" Background="White"
                                MouseDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseUp="Canvas_MouseUp"
                                PreviewMouseRightButtonDown="Canvas_PreviewMouseRightButtonDown"/>
                        <Canvas x:Name="CropOverlay" Background="Transparent" Visibility="Collapsed"
                                MouseDown="Crop_MouseDown" MouseMove="Crop_MouseMove" MouseUp="Crop_MouseUp"/>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- 底部：描述 + 按钮 -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 描述 -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="描述" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBox Grid.Column="1" x:Name="DescriptionBox"
                             VerticalContentAlignment="Center" FontSize="12"/>
                </Grid>

                <!-- 按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnEditorCancel" Content="取消" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="72" Margin="0,0,8,0"/>
                    <Button x:Name="BtnEditorSave" Content="保存" Click="Save_Click" Style="{StaticResource PrimaryButton}" Width="72"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
