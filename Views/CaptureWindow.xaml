<Window x:Class="TodayLOL.Views.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize"
        MouseDown="Window_MouseDown" MouseMove="Window_MouseMove" MouseUp="Window_MouseUp"
        KeyDown="Window_KeyDown">
    <Canvas x:Name="MainCanvas">
        <!-- 桌面截图背景 -->
        <Image x:Name="BgImage" Canvas.Left="0" Canvas.Top="0" Stretch="None"/>
        <!-- 未选中区域遮罩 -->
        <Rectangle x:Name="Overlay" Canvas.Left="0" Canvas.Top="0" Fill="#4D000000"/>
        <!-- 选区框 -->
        <Rectangle x:Name="SelectRect" Stroke="#3B78D8" StrokeThickness="2" Fill="Transparent" Visibility="Collapsed"/>
        <Rectangle x:Name="SelectRectInner" Stroke="#FFFFFF" StrokeThickness="1" Fill="Transparent" Visibility="Collapsed"/>
        <TextBlock x:Name="SizeText" Canvas.Left="0" Canvas.Top="0"
                   Background="#3B78D8" Foreground="White" Padding="8,4" FontSize="12"/>
    </Canvas>
</Window>
