<Window x:Class="TodayLOL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="640" Width="880"
        WindowStartupLocation="CenterScreen"
        Icon="{x:Static services:IconHelper.WindowIcon}"
        StateChanged="MainWindow_StateChanged"
        Closing="MainWindow_Closing"
        xmlns:services="clr-namespace:TodayLOL.Services">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 截图按钮 -->
                <Button x:Name="BtnNewCapture" Grid.Column="0" Content="新建截图" Click="ToolbarCapture_Click"
                        Style="{StaticResource PrimaryButton}" Width="90" Margin="0,0,4,0"/>

                <!-- 拼接按钮 -->
                <Button x:Name="BtnStitchCapture" Grid.Column="1" Content="拼接截图" Click="ToolbarStitch_Click"
                        Style="{StaticResource SecondaryButton}" Width="80" Margin="0,0,4,0"/>

                <!-- 视图切换 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0">
                    <Button Content="历史记录" Click="NavRecords_Click"
                            Style="{StaticResource ToolbarButton}" Tag="Records" x:Name="BtnRecords"
                            Background="{StaticResource HoverBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    <Button Content="设置" Click="NavSettings_Click"
                            Style="{StaticResource ToolbarButton}" Tag="Settings" x:Name="BtnSettings"/>
                </StackPanel>

                <!-- 右侧：搜索 -->
                <DockPanel Grid.Column="4">
                    <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="SearchBox" Width="180" VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Background="{StaticResource BackgroundBrush}"/>

    </DockPanel>
</Window>
